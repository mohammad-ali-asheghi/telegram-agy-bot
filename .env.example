# ========================================================
# Telegram Antigravity Bot Configuration
# ========================================================

# 1. Telegram Bot Token from @BotFather (Required)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Allowed Telegram User IDs (Comma-separated)
# IMPORTANT: Put your Telegram numerical user ID here to prevent unauthorized access!
# You can find your ID from @userinfobot or @raw_data_bot on Telegram.
ALLOWED_USER_IDS=123456789

# 3. SSH Connection to Host Server
# When running with Docker host network mode, 127.0.0.1 connects to your host server's SSH daemon.
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USER=root

# 4. SSH Authentication (Choose Private Key OR Password)
# Option A: SSH Key (Recommended)
# Path inside container (mapped via docker-compose volume):
SSH_PRIVATE_KEY_PATH=/app/keys/id_rsa
# Path on host machine to your private key:
SSH_LOCAL_KEY_PATH=/root/.ssh/id_rsa
# If key has a passphrase, set it here (otherwise leave empty):
SSH_PASSPHRASE=

# Option B: SSH Password (If not using key)
# SSH_PASSWORD=your_server_password

# 5. Antigravity & Execution Settings
# Maximum duration (in seconds) to wait for an Antigravity prompt to complete (e.g., 300 = 5 minutes)
SSH_TIMEOUT_SECONDS=300

# Default project directory where agy commands should run on the server
DEFAULT_WORK_DIR=/root

# Default prompt mode: 'continue' (continues previous conversation) or 'new' (starts new session)
DEFAULT_MODE=continue

# Binary path or command for Antigravity CLI on the server (usually 'agy')
AGY_BIN_PATH=agy
